# Application Settings
APP_NAME="NEXUS AI - Criminal Network Analysis Backend"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="nexus-super-secret-key-change-in-production"

# PostgreSQL / Supabase Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-supabase-password"
POSTGRES_HOST="db.your-supabase-id.supabase.co"
POSTGRES_PORT=5432
POSTGRES_DB="postgres"
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-supabase-id.supabase.co:5432/postgres"

# Optional AI API Keys
GEMINI_API_KEY=""

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
