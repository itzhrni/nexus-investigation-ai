# NEXUS AI Backend Environment Configuration

# Application Configuration
APP_NAME=NEXUS AI - Criminal Network Analysis Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=nexus-super-secret-key-change-in-production

# Supabase PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_db_password
POSTGRES_HOST=db.your_supabase_project_ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.your_supabase_project_ref.supabase.co:5432/postgres

# Supabase API Credentials (For future Storage/Auth integration)
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# Gemini API Key (Optional LLM capabilities)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
